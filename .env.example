# Where PolicyDesk runs (its website API lives under /api/website/v1).
POLICYDESK_API_URL=http://localhost:3070

# Shared HMAC secret for signed calls to PolicyDesk. Must be the same value as WEBSITE_API_SECRET in PolicyDesk.
WEBSITE_API_SECRET=change-me-to-a-long-random-string

# Signs the bw_journey cookie. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOURNEY_COOKIE_SECRET=replace-with-at-least-32-random-characters
