# Where PolicyDesk runs (its website API lives under /api/website/v1).
POLICYDESK_API_URL=http://localhost:3070

# Shared HMAC secret for signed calls to PolicyDesk. Must be the same value as WEBSITE_API_SECRET in PolicyDesk.
WEBSITE_API_SECRET=change-me-to-a-long-random-string

# Signs the bw_journey cookie. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOURNEY_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Optional: Cloudflare Turnstile, the "not a bot" check on the car forms. Set both to switch it on; leave either
# empty and the forms show no check. After changing them, redeploy (the site key is read at build time).
# Cloudflare's test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always passes)
# or 2x0000000000000000000000000000000AA (always fails).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Pulse, my monitor (github.com/AbdulSubhan1/monitor). This site's log token; server errors and the
# "Lead submitted" log are sent only when it is set. Create it in the monitor repo:
#   npm run -s log-token -- brokwise | vercel env add MONITOR_LOG_TOKEN production
MONITOR_LOG_TOKEN=
